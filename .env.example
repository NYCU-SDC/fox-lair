PORT=3000
SESSION_SECRET=your-super-secret-session-key-change-this

ADMIN_PASSWORD=your-admin-password
ADMIN_USER_IDS=comma,separated,discord,user,ids

DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
DISCORD_BOT_TOKEN=your-discord-bot-token

RELAY_GPIO_PIN=17

# Physical 7-pin keypad scanner.
# Disabled by default so development machines without GPIO tools can run the server.
KEYPAD_ENABLED=false
KEYPAD_GPIO_CHIP=gpiochip0
# Wire 1..7 mapping. Defaults avoid RELAY_GPIO_PIN=17.
# 1: 147*, 2: 2580, 3: 369#, 4: 123, 5: 456, 6: 789, 7: *0#
# Matrix keypads connect each wire to GPIO only; do not connect keypad wires to GND or 3.3V.
KEYPAD_GPIO_PINS=27,22,23,24,25,5,6
KEYPAD_POLL_MS=120
KEYPAD_SETTLE_MS=30
KEYPAD_GPIOD_BIAS=pull-down
